# Copy this file to .env and fill in your values. Never commit .env.

# Which LLM the planner uses: claude or gemini
LLM_PROVIDER=gemini

# Gemini (free tier available at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=60

# Claude (paid API, from https://platform.claude.com)
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-5-5

DATABASE_URL=sqlite:///./journal.db

# Accounts. Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_MINUTES=60
VERIFY_TOKEN_HOURS=24
APP_BASE_URL=http://127.0.0.1:8000

# Email. Leave SMTP_HOST empty to print emails in the server log instead.
# Brevo (free, 300/day): smtp-relay.brevo.com, port 2525, your Brevo SMTP login and SMTP key.
# Port 2525 matters on Render's free plan, which blocks 25, 465 and 587.
SMTP_HOST=
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
RESET_TOKEN_MINUTES=30
